# Supabase project settings (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server only. Never prefix this with NEXT_PUBLIC_ or expose it in browser code.
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key_here

# Mapbox public token with Styles:Read access and deployed domain restrictions
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here
